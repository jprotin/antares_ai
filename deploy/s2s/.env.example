# Variables de deploy/s2s/.env (créé et rempli par install.sh) : modèle sans valeur.
# Ne jamais commiter .env. La veille IA (antares-tasks) n'ajoute aucune variable.

# Pont Claude Code d'ai-to-boost (vide : modèles Claude masqués)
CLAUDE_BRIDGE_TOKEN=
# Écriture des fiches de connaissance dans le RAG d'ai-to-boost
RAG_WRITE_TOKEN=
# Partage temporaire par ngrok (share.sh)
NGROK_AUTHTOKEN=
# Ton adresse Google : pendant un partage, accès complet à la veille par le tunnel
# (les autres invités la lisent seulement) ; ajoutée d'office aux invités de share.sh
SHARE_OWNER_EMAIL=
# Secret de SearXNG (généré par install.sh)
SEARXNG_SECRET=
# Jeton d'écriture du RAG intégré (profil rag-integre)
RAG_INTEGRATED_TOKEN=
# Profils compose actifs (ex. rag-integre)
COMPOSE_PROFILES=
# Adresses testées pour la connexion Internet (défaut dans compose.yaml)
WEB_PROBE_URLS=
# Interface servie (posé par ui.sh : vide = nouvelle interface)
COMPOSE_FILE=
