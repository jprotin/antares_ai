{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "titre": {
          "minLength": 1,
          "title": "Titre",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "niveau": {
          "enum": ["officiel_etat", "candidat", "vote_reel"],
          "title": "Niveau",
          "type": "string"
        },
        "publie_le": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publie Le"
        },
        "consulte_le": {
          "format": "date",
          "title": "Consulte Le",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "candidat": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidat"
        }
      },
      "required": ["id", "titre", "url", "niveau", "consulte_le"],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": ["sources"],
  "title": "Sources",
  "type": "object"
}
