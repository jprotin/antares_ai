# Point d'entrée unique : interface web + API Realtime (WebSocket) du moteur s2s.
# Gabarit : l'image nginx substitue les ${ANTARES_*} définis dans compose.yaml.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8765;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; media-src 'self' blob:; style-src 'self'; script-src 'self'" always;

    location /v1/ {
        proxy_pass http://s2s:8765;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Valeurs injectées depuis x-profile (compose.yaml) au démarrage du conteneur
    location = /config.json {
        default_type application/json;
        add_header Cache-Control no-store;
        return 200 '{"assistant":"${ANTARES_ASSISTANT}","llm":"${ANTARES_LLM}","stt":"${ANTARES_STT}","tts":"${ANTARES_TTS}","voice":"${ANTARES_VOICE}","ttsQuantization":"${ANTARES_TTS_QUANTIZATION}"}';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
