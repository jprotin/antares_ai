# Point d'entrée unique : interface web + API Realtime (WebSocket) du moteur s2s.
# Gabarit : l'image nginx substitue les ${ANTARES_*} définis dans compose.yaml.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Origine des requêtes vers le moteur (/v1/, WebSocket) et le routeur (/api/) : une page
# tierce ouverte dans le navigateur peut viser 127.0.0.1 (WebSocket intersite, sans CORS).
# Admises : aucune Origin (outils locaux : curl, scripts), l'interface locale, ou l'adresse
# publique du partage : x-antares-origin égal à l'Origin et x-antares-user présent, tous
# deux écrits par ngrok après la connexion Google (share.sh, router/write_guard.py).
map $http_origin $origin_local {
    default                 0;
    ""                      1;
    "http://127.0.0.1:8765" 1;
    "http://localhost:8765" 1;
}

map "$http_origin|$http_x_antares_origin|$http_x_antares_user" $origin_share {
    default                       0;
    "~*^(https://[^|]+)\|\1\|.+$" 1;
}

map "$origin_local$origin_share" $origin_allowed {
    default 1;
    "00"    0;
}

# Présidentielle 2027 : débit par compte du partage (x-antares-user, écrit par ngrok
# après la connexion Google). En local, l'en-tête est absent : clé vide, aucune limite.
# 60 requêtes par minute et par compte, rafale de 30 (une visite lit base, méta, quiz,
# évolution) ; au-delà, 429. Le routeur borne aussi les questions des invités (10 par
# minute, presidentielle_api.QUOTA_INVITE).
limit_req_zone $http_x_antares_user zone=presidentielle_partage:1m rate=60r/m;

# Serveur par défaut : tout Host autre que 127.0.0.1 ou localhost (DNS rebinding : un nom
# piégé qui pointe vers 127.0.0.1) reçoit une connexion fermée sans réponse. Le partage
# ngrok (share.sh, --host-header=rewrite) arrive sous le nom local.
server {
    listen 8765 default_server;
    server_name _;
    return 444;
}

server {
    listen 8765;
    server_name 127.0.0.1 localhost;

    # DNS de Docker, re-résolu à chaque requête : un service recréé change d'IP
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $s2s_upstream http://s2s:8765;
    set $router_upstream http://llm-router:11434;

    root /usr/share/nginx/html;
    index index.html;

    # En-têtes de sécurité. Un add_header dans une location annule ceux du server : les
    # locations qui en ajoutent un (Cache-Control) les répètent.
    # frame-ancestors et X-Frame-Options : jamais intégrée dans une page tierce (partage ngrok)
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; media-src 'self' blob:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'" always;
    add_header X-Frame-Options DENY always;

    location /v1/ {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $s2s_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Valeurs fixes injectées depuis x-profile (compose.yaml) au démarrage du conteneur
    location = /config.json {
        default_type application/json;
        add_header Cache-Control no-store;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; media-src 'self' blob:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'" always;
        add_header X-Frame-Options DENY always;
        return 200 '{"stt":"${ANTARES_STT}","tts":"${ANTARES_TTS}","ttsQuantization":"${ANTARES_TTS_QUANTIZATION}"}';
    }

    # Conversation écrite : tout l'historique est envoyé à chaque question, et la
    # réponse arrive en flux (SSE) : pas de mise en tampon, délai long (Claude, réponses
    # longues). 4 Ko (limite de /api/) bloquait la conversation dès quelques échanges.
    location = /api/chat {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 2m;
    }

    # Documents joints (PDF, Word, texte, images) : 15 Mo au plus, cf. documents.py
    location = /api/documents {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
        client_max_body_size 15m;
    }

    # Documents du RAG intégré : même taille que les documents joints ; l'indexation
    # (embeddings sur le processeur) prend jusqu'à une minute pour un long document
    location ~ ^/api/rag/projects/[a-z0-9_-]+/documents$ {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        client_max_body_size 15m;
    }

    # Répétitions : slides en PDF (15 Mo), discours transcrit, rapport rédigé par le
    # modèle (jusqu'à quelques minutes sur un long discours)
    location ~ ^/api/rehearsals/.+ {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        client_max_body_size 16m;
    }

    # Veille : prompt d'une idée ou traduction d'un article par le modèle (délai du
    # routeur : idea_prompt.timeout_s de tasks.yaml, 120 s par défaut, plus le chargement
    # éventuel du modèle)
    location ~ "^/api/veille/(idea/[0-9a-f]{16}/prompt|article/[0-9a-f]{16}/translate)$" {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
        client_max_body_size 1k;
    }

    # Assistant de la présidentielle : question de 500 caractères au plus envoyée en POST
    # (absente du journal d'accès), corps de 4 Ko au plus ; choix des passages par le
    # modèle local, plus son chargement éventuel. Pas d'add_header : les en-têtes de
    # sécurité du server s'appliquent.
    # Délai : pire cas du routeur (presidentielle_api, presidentielle_index,
    # presidentielle_assistant) = recherche par le sens 20 s (DELAI_SENS) + attente du
    # tour de génération 20 s (ATTENTE_VERROU) + modèle 150 s (DELAI_MODELE, chargement
    # compris) + liste des modèles, soit un peu plus de 190 s : 240 s, pour que la
    # réponse du routeur (504 « trop de temps » compris) arrive toujours au navigateur.
    location = /api/presidentielle/ask {
        # Origine étrangère (cf. map $origin_allowed) : refusée
        if ($origin_allowed = 0) {
            return 403;
        }
        limit_req zone=presidentielle_partage burst=10 nodelay;
        limit_req_status 429;
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 240s;
        client_max_body_size 4k;
    }

    # Lectures de la présidentielle (base, méta, quiz, évolution) et routes du
    # propriétaire : comme /api/, plus le débit par compte du partage
    location /api/presidentielle {
        if ($origin_allowed = 0) {
            return 403;
        }
        limit_req zone=presidentielle_partage burst=30 nodelay;
        limit_req_status 429;
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        client_max_body_size 64k;
        # Base publique (plusieurs Mo de fiches) : compressée pour les invités du partage.
        # Données publiques, sans secret ni écho de la requête : pas de risque BREACH.
        gzip on;
        gzip_proxied any;
        gzip_types application/json;
        gzip_min_length 1024;
        gzip_comp_level 5;
        gzip_vary on;
    }

    # Réglages (modèle, voix, agent, mode…) et agents : routeur LLM
    location /api/ {
        # Défense en profondeur (le routeur contrôle aussi les écritures, write_guard.py)
        if ($origin_allowed = 0) {
            return 403;
        }
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        # Fiche d'agent : jusqu'à 4 000 caractères d'instructions (accents : ~2 octets)
        client_max_body_size 64k;
    }

    # Catalogue fusionné par le routeur (voix versionnées + voix personnelles locales)
    location = /voices/voices.json {
        rewrite ^ /api/voices break;
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
    }

    location /voices/ {
        alias /srv/voices/;
        # Voix personnelles (prises brutes, extraits clonés) : seuls les aperçus sont
        # servis ; le moteur lit les extraits sur le disque. Exposé sinon par share.sh.
        location ~ ^/voices/perso/(?!apercu/[^/]+\.wav$) {
            return 404;
        }
        add_header Cache-Control no-store;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; media-src 'self' blob:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'" always;
        add_header X-Frame-Options DENY always;
    }

    location / {
        try_files $uri $uri/ =404;
        # Fichiers statiques de l'interface (scripts, styles) : compressés pour le partage
        gzip on;
        gzip_types text/css application/javascript image/svg+xml application/json;
        gzip_min_length 1024;
        gzip_vary on;
    }
}
