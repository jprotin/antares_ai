# Point d'entrée unique : interface web + API Realtime (WebSocket) du moteur s2s.
# Gabarit : l'image nginx substitue les ${ANTARES_*} définis dans compose.yaml.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8765;
    server_name _;

    # DNS de Docker, re-résolu à chaque requête : un service recréé change d'IP
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $s2s_upstream http://s2s:8765;
    set $router_upstream http://llm-router:11434;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; media-src 'self' blob:; style-src 'self'; script-src 'self'" always;

    location /v1/ {
        proxy_pass $s2s_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Valeurs fixes injectées depuis x-profile (compose.yaml) au démarrage du conteneur
    location = /config.json {
        default_type application/json;
        add_header Cache-Control no-store;
        return 200 '{"stt":"${ANTARES_STT}","tts":"${ANTARES_TTS}","ttsQuantization":"${ANTARES_TTS_QUANTIZATION}"}';
    }

    # Conversation écrite : tout l'historique est envoyé à chaque question, et la
    # réponse arrive en flux (SSE) : pas de mise en tampon, délai long (Claude, réponses
    # longues). 4 Ko (limite de /api/) bloquait la conversation dès quelques échanges.
    location = /api/chat {
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 2m;
    }

    # Documents joints (PDF, Word, texte, images) : 15 Mo au plus, cf. documents.py
    location = /api/documents {
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 180s;
        client_max_body_size 15m;
    }

    # Réglages (modèle, voix, agent, mode…) et agents : routeur LLM
    location /api/ {
        proxy_pass $router_upstream;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        # Fiche d'agent : jusqu'à 4 000 caractères d'instructions (accents : ~2 octets)
        client_max_body_size 64k;
    }

    location /avatars/ {
        alias /srv/avatars/;
        add_header Cache-Control no-store;
    }

    location /voices/ {
        alias /srv/voices/;
        add_header Cache-Control no-store;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
