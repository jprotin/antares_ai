<mxfile host="antares" agent="antares-doc" version="24.7.0"><diagram id="arch" name="Architecture micro-services"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arch-1" value="antares_ai — architecture micro-services (poste local, 100 % hors ligne par défaut)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="arch-2" value="Poste utilisateur" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;arcSize=3;fontFamily=Helvetica;fontSize=12;fillColor=#FFFAF3;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="300" as="geometry"/></mxCell><mxCell id="arch-3" value="&lt;b&gt;Navigateur (Firefox)&lt;/b&gt;&lt;br&gt;Interface d&#x27;appel statique (HTML/JS)&lt;br&gt;&lt;br&gt;• micro → PCM 24 kHz (AudioWorklet)&lt;br&gt;• orbe animé, sous-titres&lt;br&gt;• saisie écrite, conversation unique&lt;br&gt;• agent / mode, thème clair / sombre&lt;br&gt;• rendu Markdown, code coloré&lt;br&gt;&lt;br&gt;&lt;i&gt;http://127.0.0.1:8765&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="240" as="geometry"/></mxCell><mxCell id="arch-4" value="Compose antares-s2s (deploy/s2s/compose.yaml)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;arcSize=3;fontFamily=Helvetica;fontSize=12;fillColor=#F7FAFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="340" y="80" width="820" height="700" as="geometry"/></mxCell><mxCell id="arch-5" value="Réseau antares-local — internal : aucune route vers Internet" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;arcSize=3;fontFamily=Helvetica;fontSize=12;fillColor=#EEF4FF;strokeColor=#3D6FB6;fontColor=#1F4E8C;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="700" height="420" as="geometry"/></mxCell><mxCell id="arch-6" value="&lt;b&gt;web&lt;/b&gt; — nginx 1.29&lt;br&gt;&lt;i&gt;réseaux : antares-edge + antares-local&lt;/i&gt;&lt;br&gt;port hôte 127.0.0.1:8765&lt;br&gt;&lt;br&gt;/ → interface (frontend/)&lt;br&gt;/voices, /config.json&lt;br&gt;/v1/realtime → s2s (WebSocket)&lt;br&gt;/api/chat → llm-router (SSE)&lt;br&gt;/api/* → llm-router" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="250" height="240" as="geometry"/></mxCell><mxCell id="arch-7" value="&lt;b&gt;s2s&lt;/b&gt; — huggingface/speech-to-speech 1.0.0 (GPU)&lt;br&gt;&lt;i&gt;réseau : antares-local uniquement&lt;/i&gt;&lt;br&gt;&lt;br&gt;• VAD Silero + Smart Turn (fin de parole)&lt;br&gt;• STT Parakeet TDT (français)&lt;br&gt;• client LLM chat-completions → llm-router&lt;br&gt;• TTS Qwen3-TTS 1.7B Base Q8_0&lt;br&gt;&amp;nbsp;&amp;nbsp;voix clonée (x-vector), tirage bridé&lt;br&gt;&amp;nbsp;&amp;nbsp;(qwen3_sampling.py)&lt;br&gt;• API Realtime (WebSocket, PCM)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="300" height="230" as="geometry"/></mxCell><mxCell id="arch-8" value="&lt;b&gt;llm-router&lt;/b&gt; — FastAPI (Python)&lt;br&gt;&lt;i&gt;réseaux : antares-local + ai-assistant-net&lt;/i&gt;&lt;br&gt;&lt;br&gt;• /v1 : relais voix → Ollama ou Claude&lt;br&gt;• /api/chat : conversation écrite (SSE)&lt;br&gt;• réglages, modes, agents (CRUD)&lt;br&gt;• RAG : projet choisi ou cité&lt;br&gt;• voicecode : code retiré de la voix,&lt;br&gt;&amp;nbsp;&amp;nbsp;affiché à l&#x27;écran, restauré en mémoire&lt;br&gt;• mesures de latence par modèle" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="980" y="330" width="300" height="250" as="geometry"/></mxCell><mxCell id="arch-9" value="antares-s2s-cache&lt;br&gt;(modèles HF)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=10;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="660" y="600" width="130" height="60" as="geometry"/></mxCell><mxCell id="arch-10" value="antares-router-data&lt;br&gt;settings, agents.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=10;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="1000" y="610" width="150" height="60" as="geometry"/></mxCell><mxCell id="arch-11" value="voices/ (bind)&lt;br&gt;voix clonées" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fontSize=10;fillColor=#F5F5F5;strokeColor=#9E9E9E;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="arch-12" value="&lt;b&gt;warmup&lt;/b&gt; (profil install)&lt;br&gt;&lt;i&gt;réseaux : antares-local + antares-download&lt;/i&gt;&lt;br&gt;seul accès Internet : préchargement&lt;br&gt;des modèles par install.sh" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="600" width="250" height="100" as="geometry"/></mxCell><mxCell id="arch-13" value="Stack ai-to-boost — réseau ai-assistant-net" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;arcSize=3;fontFamily=Helvetica;fontSize=12;fillColor=#F3FAF2;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1320" y="80" width="300" height="460" as="geometry"/></mxCell><mxCell id="arch-14" value="&lt;b&gt;ollama&lt;/b&gt; :11434 (GPU)&lt;br&gt;gemma4:e4b (défaut, ~1 s)&lt;br&gt;gemma4:26b, qwen3.5:9b…&lt;br&gt;API OpenAI /v1 (streaming)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1340" y="120" width="260" height="110" as="geometry"/></mxCell><mxCell id="arch-15" value="&lt;b&gt;rag&lt;/b&gt; :8100&lt;br&gt;POST /query — FastEmbed nomic 768d&lt;br&gt;(recherche multi-collections)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1340" y="260" width="260" height="100" as="geometry"/></mxCell><mxCell id="arch-16" value="&lt;b&gt;qdrant&lt;/b&gt; :6333&lt;br&gt;collections : knowledge (commune)&lt;br&gt;proj-&amp;lt;projet&amp;gt; (par projet)&lt;br&gt;alimentées par ai-to-boost" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1340" y="390" width="260" height="110" as="geometry"/></mxCell><mxCell id="arch-17" value="Hôte (hors conteneurs)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;arcSize=3;fontFamily=Helvetica;fontSize=12;fillColor=#FBF7FC;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1320" y="580" width="300" height="200" as="geometry"/></mxCell><mxCell id="arch-18" value="&lt;b&gt;claude-bridge&lt;/b&gt; :8088 (systemd)&lt;br&gt;exécute &lt;i&gt;claude -p&lt;/i&gt; (abonnement)&lt;br&gt;option : modèles Claude Opus / Sonnet" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1340" y="620" width="260" height="90" as="geometry"/></mxCell><mxCell id="arch-19" value="&lt;b&gt;Anthropic&lt;/b&gt; (Internet)&lt;br&gt;seul cas où du texte quitte la machine" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1340" y="820" width="260" height="60" as="geometry"/></mxCell><mxCell id="arch-20" value="&lt;b&gt;GPU partagé&lt;/b&gt; : RTX 5070 Ti Laptop 12 Go — s2s (STT + TTS Q8_0) + Ollama (LLM) ≈ 10 à 11 Go" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;shadow=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="520" height="60" as="geometry"/></mxCell><mxCell id="arch-21" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="arch-3" target="arch-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-22" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.7;dashed=1;" edge="1" parent="1" source="arch-3" target="arch-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-23" value="②" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.3;dashed=1;" edge="1" parent="1" source="arch-6" target="arch-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-24" value="① /api, /api/chat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.8;" edge="1" parent="1" source="arch-6" target="arch-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="495" y="540"/></Array></mxGeometry></mxCell><mxCell id="arch-25" value="③ chat/completions (SSE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0.5;entryY=0;" edge="1" parent="1" source="arch-7" target="arch-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="331"/></Array></mxGeometry></mxCell><mxCell id="arch-26" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-8" target="arch-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-27" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.45;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-8" target="arch-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-28" value="⑤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-8" target="arch-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="arch-15" target="arch-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-30" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.95;entryX=0;entryY=0.5;" edge="1" parent="1" source="arch-8" target="arch-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-31" value="⑦ HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="arch-18" target="arch-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=none;" edge="1" parent="1" source="arch-7" target="arch-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=none;" edge="1" parent="1" source="arch-7" target="arch-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=none;" edge="1" parent="1" source="arch-8" target="arch-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arch-35" value="① Interface et API : nginx sert la page statique et relaie /api vers le routeur (/api/chat en flux SSE, sans tampon).  ② Appel vocal : audio et événements Realtime en WebSocket entre le navigateur et le moteur s2s (via nginx).  ③ Le moteur s2s appelle le LLM au format OpenAI chat-completions ; c&#x27;est le routeur qui répond.  ④ Le routeur applique mode, agent, documentation et filtre du code, puis relaie vers Ollama.  ⑤ Documentation des projets : recherche dans le RAG d&#x27;ai-to-boost (collections knowledge et proj-*).  ⑥⑦ Option Claude : via le claude-bridge de l&#x27;hôte (claude -p), seul flux sortant vers Internet.  Le conteneur s2s n&#x27;a aucune route vers Internet (réseau internal) ; check-local.sh le vérifie." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1580" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flux" name="Tour de parole et chemin écrit"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flux-1" value="Déroulé d&#x27;un tour de parole (voix) et du chemin écrit" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="flux-2" value="Navigateur" style="swimlane;horizontal=0;html=1;startSize=36;fontStyle=1;fontSize=13;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1580" height="160" as="geometry"/></mxCell><mxCell id="flux-3" value="s2s" style="swimlane;horizontal=0;html=1;startSize=36;fontStyle=1;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1580" height="160" as="geometry"/></mxCell><mxCell id="flux-4" value="llm-router" style="swimlane;horizontal=0;html=1;startSize=36;fontStyle=1;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1580" height="160" as="geometry"/></mxCell><mxCell id="flux-5" value="LLM / RAG" style="swimlane;horizontal=0;html=1;startSize=36;fontStyle=1;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1580" height="160" as="geometry"/></mxCell><mxCell id="flux-6" value="&lt;b&gt;Micro&lt;/b&gt;&lt;br&gt;PCM 24 kHz (AudioWorklet)&lt;br&gt;annulation d&#x27;écho du navigateur" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="flux-7" value="&lt;b&gt;VAD Silero + Smart Turn&lt;/b&gt;&lt;br&gt;fin de parole détectée&lt;br&gt;(~45 ms)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="170" height="90" as="geometry"/></mxCell><mxCell id="flux-8" value="&lt;b&gt;STT Parakeet TDT&lt;/b&gt;&lt;br&gt;texte (~25 ms)&lt;br&gt;sous-titres en direct" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="170" height="90" as="geometry"/></mxCell><mxCell id="flux-9" value="&lt;b&gt;Préparation&lt;/b&gt;&lt;br&gt;1. code restauré dans l&#x27;historique&lt;br&gt;2. mode (ton, structure)&lt;br&gt;3. agent choisi ou cité&lt;br&gt;4. RAG : projet choisi ou cité" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="500" y="440" width="190" height="110" as="geometry"/></mxCell><mxCell id="flux-10" value="&lt;b&gt;RAG&lt;/b&gt; (si projet)&lt;br&gt;rag :8100 → qdrant&lt;br&gt;4 extraits, ~50-100 ms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="500" y="615" width="190" height="90" as="geometry"/></mxCell><mxCell id="flux-11" value="&lt;b&gt;LLM en flux&lt;/b&gt;&lt;br&gt;Ollama gemma4 (~0,4 s au 1er mot)&lt;br&gt;ou Claude via bridge (~7 s)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="730" y="615" width="190" height="90" as="geometry"/></mxCell><mxCell id="flux-12" value="&lt;b&gt;Filtre voicecode&lt;/b&gt;&lt;br&gt;blocs de code retirés du texte&lt;br&gt;prononcé, gardés pour l&#x27;écran&lt;br&gt;(/api/turn/last)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="730" y="440" width="190" height="110" as="geometry"/></mxCell><mxCell id="flux-13" value="&lt;b&gt;TTS Qwen3 (voix clonée)&lt;/b&gt;&lt;br&gt;phrase par phrase&lt;br&gt;1er son ≈ 1 s après la fin de parole" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="960" y="280" width="190" height="90" as="geometry"/></mxCell><mxCell id="flux-14" value="&lt;b&gt;Lecture + sous-titres&lt;/b&gt;&lt;br&gt;orbe « parole »&lt;br&gt;code affiché sous la réponse" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="190" height="90" as="geometry"/></mxCell><mxCell id="flux-15" value="&lt;b&gt;Écrit&lt;/b&gt; (hors appel)&lt;br&gt;saisie → /api/chat&lt;br&gt;réponse Markdown en flux" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#D79B00;dashed=1;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="170" height="90" as="geometry"/></mxCell><mxCell id="flux-16" value="&lt;b&gt;/api/chat&lt;/b&gt;&lt;br&gt;même préparation&lt;br&gt;(consigne écrite, sources citées)&lt;br&gt;pas de filtre du code" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;dashed=1;" vertex="1" parent="1"><mxGeometry x="1420" y="440" width="170" height="110" as="geometry"/></mxCell><mxCell id="flux-17" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flux-6" target="flux-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="flux-7" target="flux-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-19" value="chat/completions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="flux-8" target="flux-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="flux-9" target="flux-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="flux-9" target="flux-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-22" value="flux SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="flux-11" target="flux-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-23" value="texte à prononcer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0.5;entryY=1;" edge="1" parent="1" source="flux-12" target="flux-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-24" value="audio + transcription" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="flux-13" target="flux-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-25" value="blocs de code (fin de réponse)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0.8;entryY=1;dashed=1;" edge="1" parent="1" source="flux-12" target="flux-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="517"/></Array></mxGeometry></mxCell><mxCell id="flux-26" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0.3;entryY=0;dashed=1;" edge="1" parent="1" source="flux-15" target="flux-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="flux-16" target="flux-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="660"/></Array></mxGeometry></mxCell><mxCell id="flux-28" value="réponse Markdown (SSE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;entryX=0.85;entryY=1;dashed=1;" edge="1" parent="1" source="flux-16" target="flux-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flux-29" value="Conversation unique : les messages écrits sont rejoués au moteur vocal au début d&#x27;un appel (30 derniers, ~24 000 caractères) ; ce qui se dit en appel reste dans le fil écrit. Un message tapé pendant l&#x27;appel suit le chemin vocal (réponse à voix haute). La consigne est assemblée dans l&#x27;ordre : consigne de l&#x27;interface (voix / écrit), mode, agent, documentation." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1580" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
