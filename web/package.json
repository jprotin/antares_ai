{
  "name": "antares-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:app",
    "build:app": "tsc -p tsconfig.app.json && vite build && node scripts/licenses-inventory.mjs && node scripts/version.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "preview:nginx": "cd ../deploy/s2s && ./ui.sh new --build",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:mock": "playwright test --project=chromium-mock",
    "test:e2e:live": "playwright test --project=chromium-live --project=smoke",
    "test:offline": "playwright test --project=offline-strict",
    "test:perf": "playwright test --project=perf",
    "test:smoke": "playwright test --project=smoke",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "lucide-react": "1.59.0",
    "marked": "18.0.14",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.160.1",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
