{
  "name": "antares-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e:mock": "playwright test --project=chromium-mock",
    "test:e2e:live": "playwright test --project=chromium-live --project=smoke",
    "test:offline": "playwright test --project=offline-strict",
    "test:perf": "playwright test --project=perf",
    "test:smoke": "playwright test --project=smoke"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "lucide-react": "1.59.0",
    "marked": "18.0.14",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.160.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
